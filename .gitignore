# Paquete para probar en una maquina virtual (se regenera; ~37 MB)
respaldos/
DigLab-VM.zip
DigLab-VM-actualizacion.zip
# Paquete extraido para instalar en este equipo (se regenera del zip)
/DigLab-Paquete/

# ---- Datos reales de la escuela: NUNCA al repo ----
# Respaldos de la base del TESCHI (nombres, correos y hashes de alumnos) y
# manuales con la contrasena del servidor en claro.
ANTIGUA REPO/
ANTIGUOS MANUALES/

# A que equipo apunta una copia concreta del paquete. Es de la instalacion,
# no del codigo: lo escribe el instalador al preparar el servidor.
servidor.config

# API de recuperacion: la configuracion lleva contrasenas (base y correo), y
# cualquier copia suya tambien ("config - copia.php", config.php.bak...).
api/config*.php
!api/config.example.php
api/*.bak
api/*~
api/*.save
api/*.swp
api/*.txt
api/error_log
